class Solution {
    public int mySqrt(int x) {
        int l=0;
        int r=x/2;
        int ans = 0;
        while(l<=r){
        int mid=(l+r)/2;
        long s=(long) mid*mid;
        if(s==x){
            ans = mid;
            return ans;
        }
        else if(s<x) {
            ans=mid;
            l=mid+1;
        }
        else{
            r=mid-1;
        }
    }
    return ans;
    }
}
Example 1:

Input: x = 4
Output: 2
Explanation: The square root of 4 is 2, so we return 2.
Example 2:

Input: x = 8
Output: 2
Explanation: The square root of 8 is 2.82842..., and since we round it down to the nearest integer, 2 is returned.
 
