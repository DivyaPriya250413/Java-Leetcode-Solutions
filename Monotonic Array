class Solution {
    public boolean isMonotonic(int[] nums) { 
        int a=nums.length;
        int in=0;
        int d=0;
        for(int i=0;i<a-1;i++){
            if(nums[i]<nums[i+1]){
                in++;
            }
            else if(nums[i]>nums[i+1]){
                d++;
            }
        }
        return!(in>0 && d>0);
    }
}
Example 1:
Input: nums = [1,2,2,3]
Output: true

Example 2:
Input: nums = [6,5,4,4]
Output: true

Example 3:
Input: nums = [1,3,2]
Output: false
